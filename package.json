{
  "name": "migration-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic data migration planner and reconciliation workbench (Legacy CRM -> accounts)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run dev:server & npm run dev:web",
    "dev:server": "TZ=UTC node --env-file-if-exists=.env --watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "TZ=UTC node --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:e2e": "playwright test",
    "gen:dataset": "node scripts/gen-dataset.ts",
    "smoke:agent": "TZ=UTC node --env-file-if-exists=.env scripts/smoke-agent.ts",
    "bench": "TZ=UTC node scripts/bench.ts",
    "db:reset": "rm -f data/workbench.db data/workbench.db-wal data/workbench.db-shm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.12",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
