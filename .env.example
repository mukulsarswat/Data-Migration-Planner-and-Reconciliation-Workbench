# Copy to .env and fill in. Never commit .env or real credentials.
# Empty values (KEY=) mean "unset": the default applies.

# --- Server ---
PORT=8787
# SQLite file. Local default: ./data/workbench.db. The Docker image already sets /data/workbench.db (mount a volume at
# /data); leave this commented when using `docker run --env-file .env`, or the database would live outside the volume.
# DB_PATH=./data/workbench.db
LOG_LEVEL=info
# Structured JSON logs to stdout (the last 1000 entries are also served at /api/logs).
# LOG_TO_STDOUT=true
# Built web app served by the API (npm run build → ./dist).
# STATIC_DIR=./dist
# Behind a reverse proxy (e.g. Railway): take the client IP for per-IP caps from the proxy-appended X-Forwarded-For hop.
TRUST_PROXY=false

# --- LLM (Anthropic) ---
# Without a key the agent is unavailable and the UI offers a deterministic heuristic draft instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high
ANTHROPIC_EFFORT=medium
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_MS=180000

# --- Demo protection (hosted) ---
# Set BOTH to require HTTP Basic auth on every route except /api/health (setting only one is a startup error).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Agent-run caps (per client IP per UTC day / global per UTC day)
AGENT_RUNS_PER_IP_PER_DAY=10
AGENT_RUNS_GLOBAL_PER_DAY=60

# --- Demo controls ---
# Allow the "simulate failure after N records" control used to demonstrate retry.
ALLOW_FAULT_INJECTION=true
